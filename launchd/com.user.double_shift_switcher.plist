<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.user.double_shift_switcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/DoubleShift.app/Contents/MacOS/DoubleShift</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/double_shift_switcher.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/double_shift_switcher.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
